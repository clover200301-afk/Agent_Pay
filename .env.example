# Monad Testnet
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143

# AgentPay 合约地址（运行 ./scripts/deploy.sh 后会自动写回）
NEXT_PUBLIC_AGENTPAY_ADDRESS=

# 收款方地址（demo 用，可填项目自己的钱包）
NEXT_PUBLIC_MERCHANT_ADDRESS=0x000000000000000000000000000000000000dEaD

# WalletConnect Project ID（https://cloud.walletconnect.com 申请）
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# 合约部署用（不会被 Next.js 暴露到前端）
OWNER_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# NextAuth (Auth.js v5)
# 必填：会话签名密钥。本地随便填一个长串即可（生产环境务必换）。
# 生成：openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=

# Google OAuth (可空 —— 留空时登录页 Google 按钮置灰)
# 申请：https://console.cloud.google.com/apis/credentials
# 回调：${origin}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (可空 —— 留空时登录页 Apple 按钮置灰)
# 申请：https://developer.apple.com/account/resources/identifiers/list/serviceId
# 回调：${origin}/api/auth/callback/apple
APPLE_ID=
APPLE_SECRET=
